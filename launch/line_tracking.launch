<?xml version="1.0"?>
<launch>

  <!-- Launch Gazebo with custom world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find mecanum_car)/worlds/agv.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Spawn AGV robot -->
  <param name="robot_description" command="cat $(find mecanum_car)/urdf/agv.urdf"/>
  
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-urdf -model agv_robot -param robot_description -x -2.3 -y -1 -z 0.04"
        output="screen"/>

  <!-- Robot State Publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- Line Tracer Node -->
  <node name="line_tracer" pkg="mecanum_car" type="line_tracer.py" output="screen"/>

  <!-- Obstacle Detector Node -->
  <node name="obstacle_detector" pkg="mecanum_car" type="obstacle_detector.py" output="screen"/>

</launch>